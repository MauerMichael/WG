# Template fuer .env — echte Werte nie hier eintragen, nur in .env
# (.env ist via .gitignore ausgeschlossen).

# --- Datenbank ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=your_db_host
POSTGRES_PORT=5432

# Im Deploy auf derselben VPS: HOST=127.0.0.1 (Container im selben Netz),
# damit ihr keinen Netzwerk-Roundtrip pro Query habt.
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# --- App ---
# In Dev: APP_ENV=development. Im Prod-Deploy wird die Auswahl ueber wsgi.py
# fest auf "prod" gesetzt — dieser Wert hier ist nur informativ.
APP_ENV=development

# PFLICHT in Prod: ein zufaelliger 32+-Zeichen-Schluessel. Default in DevConfig
# ist ein bekannter Platzhalter → wuerde Session-Hijacking erlauben.
# Generieren: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_random_secret_here

# --- Google OAuth ---
# In Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs anlegen.
# Authorized redirect URI muss exakt sein: https://<deine-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP fuer Reminder-Mails ---
# Optional. Wenn leer, faellt scripts/send_reminders.py mit klarem Fehler aus.
# Bei Gmail: App-Password verwenden, nicht das normale Passwort.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
